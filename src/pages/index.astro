---
import Layout from '../layouts/Layout.astro';
import { Desktop } from '../components/desktop/Desktop';

// SEO data for the homepage
const seoData = {
  title: "Talha Balaj - Full Stack Engineer | React, Node.js, TypeScript Developer",
  description: "Experienced Full Stack Engineer specializing in React, Node.js, TypeScript, and modern web technologies. Available for exciting opportunities in software development.",
  keywords: [
    "Full Stack Developer",
    "React Developer",
    "Node.js Developer",
    "TypeScript",
    "JavaScript",
    "Software Engineer",
    "Web Developer",
    "Frontend Developer",
    "Backend Developer",
    "Talha Balaj",
    "Portfolio",
    "Software Development",
    "Modern Web Technologies"
  ]
};
---

<Layout {...seoData}>
  <Desktop client:load />
</Layout>

<!-- Static SEO Content (hidden but crawlable) -->
<div class="sr-only">
  <h1>Talha Balaj - Full Stack Engineer</h1>
  <p>Experienced Full Stack Engineer specializing in React, Node.js, TypeScript, and modern web technologies. Currently working at mobileLive, Inc in Toronto, ON.</p>

  <h2>Technical Skills</h2>
  <ul>
    <li>Frontend: React, NextJS, TypeScript, JavaScript, Tailwind CSS</li>
    <li>Backend: Node.js, NestJS, Express, AWS Lambda</li>
    <li>Database: MySQL, PostgreSQL, MongoDB</li>
    <li>DevOps: Docker, Git, GitHub Actions, AWS</li>
  </ul>

  <h2>Work Experience</h2>
  <article>
    <h3>Senior Software Engineer at mobileLive, Inc</h3>
    <p>April 2024 - Present | Toronto, ON</p>
    <p>Reverse engineered and rebuilt in-house pricing engine SDK for Staples.ca. Lead development of new NextJS checkout experience for the entire store platform.</p>
  </article>

  <article>
    <h3>Software Engineer at Nextbridge, Inc</h3>
    <p>June 2022 - March 2024 | Lahore, Pakistan</p>
    <p>Developed customer device management interface with real-time tracking. Led migration from Create React App to NextJS.</p>
  </article>

  <h2>Education</h2>
  <article>
    <h3>Bachelors in Computer Science</h3>
    <p>University of Engineering and Technology, Lahore | 2018 - 2022</p>
    <p>GPA: 3.4/4.0</p>
  </article>

  <h2>Contact</h2>
  <ul>
    <li>Email: <a href="mailto:hey@talhabalaj.com">hey@talhabalaj.com</a></li>
    <li>GitHub: <a href="https://github.com/talhabalaj">github.com/talhabalaj</a></li>
    <li>LinkedIn: <a href="https://www.linkedin.com/in/talhabalaj">linkedin.com/in/talhabalaj</a></li>
  </ul>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
