---
import Layout from '../layouts/Layout.astro';

const seoData = {
  title: "404 - Page Not Found | Talha Balaj",
  description: "The page you're looking for doesn't exist.",
};
---

<Layout {...seoData}>
  <div class="bsod">
    <div class="bsod-content">
      <div class="bsod-emoticon">:(</div>

      <h1 class="bsod-title">
        Your PC ran into a problem and needs to restart.
        We're just collecting some error info, and then we'll
        restart for you.
      </h1>

      <div class="bsod-progress">
        <span class="progress-text">404% complete</span>
      </div>

      <div class="bsod-info">
        <div class="qr-placeholder">
          <div class="qr-fake"></div>
        </div>
        <div class="info-text">
          <p>For more information about this issue and possible fixes, visit</p>
          <p class="info-link">https://talhabalaj.com</p>
          <br />
          <p>If you call a support person, give them this info:</p>
          <p class="error-code">Stop code: PAGE_NOT_FOUND_EXCEPTION</p>
        </div>
      </div>

      <div class="bsod-actions">
        <a href="/" class="restart-button">
          Restart (Go Home)
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .bsod {
    position: fixed;
    inset: 0;
    background: #0078d4;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    font-family: 'Segoe UI', system-ui, sans-serif;
    color: white;
  }

  .bsod-content {
    max-width: 800px;
    text-align: left;
  }

  .bsod-emoticon {
    font-size: 8rem;
    font-weight: 200;
    margin-bottom: 2rem;
    line-height: 1;
  }

  .bsod-title {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .bsod-progress {
    margin-bottom: 3rem;
  }

  .progress-text {
    font-size: 1.25rem;
  }

  .bsod-info {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .qr-placeholder {
    flex-shrink: 0;
  }

  .qr-fake {
    width: 100px;
    height: 100px;
    background: white;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    grid-template-rows: repeat(10, 1fr);
    gap: 2px;
    padding: 5px;
  }

  .qr-fake::before {
    content: '';
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    background:
      repeating-linear-gradient(
        90deg,
        #000 0px,
        #000 8px,
        transparent 8px,
        transparent 12px
      ),
      repeating-linear-gradient(
        0deg,
        #000 0px,
        #000 8px,
        transparent 8px,
        transparent 12px
      );
    background-size: 20px 20px;
    opacity: 0.8;
  }

  .info-text {
    font-size: 0.75rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .info-link {
    text-decoration: underline;
  }

  .error-code {
    margin-top: 0.5rem;
  }

  .bsod-actions {
    margin-top: 2rem;
  }

  .restart-button {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: white;
    color: #0078d4;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .restart-button:hover {
    background: #f0f0f0;
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .bsod-emoticon {
      font-size: 5rem;
    }

    .bsod-title {
      font-size: 1.125rem;
    }

    .bsod-info {
      flex-direction: column;
    }

    .qr-fake {
      width: 80px;
      height: 80px;
    }
  }
</style>
